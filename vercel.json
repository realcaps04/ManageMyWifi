{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:shared && npm run build -w @wifi-control/api && npm run build -w @wifi-control/web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api$).*)", "destination": "/index.html" }
  ]
}
