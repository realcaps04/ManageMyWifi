API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development
# Comma-separated. Include your Vercel URL in production.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
AGENT_SHARED_SECRET=dev-agent-shared-secret
DEV_AUTH_BYPASS=true
DEV_NETWORK_ID=00000000-0000-4000-8000-000000000001

# Optional — when set, API can use Supabase (service role). Milestone 1 works with memory store.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
