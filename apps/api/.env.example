API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development
# Comma-separated. Include your Vercel URL in production.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
AGENT_SHARED_SECRET=dev-agent-shared-secret
SESSION_SECRET=change-me-session-secret

# Web sign-in: WiFi network name + verification password
WIFI_LOGIN_SSID=YourWifiName
WIFI_LOGIN_PASSWORD=change-me-wifi-portal-password

# Set true only to skip sign-in during local debugging
DEV_AUTH_BYPASS=true
DEV_NETWORK_ID=00000000-0000-4000-8000-000000000001
