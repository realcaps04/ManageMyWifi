# Local API while developing:
BACKEND_URL=http://localhost:4000/api/v1
# After Vercel deploy, use your site instead, e.g.:
# BACKEND_URL=https://your-app.vercel.app/api/v1
AGENT_SHARED_SECRET=dev-agent-shared-secret
AGENT_NAME=local-agent
NETWORK_ID=00000000-0000-4000-8000-000000000001

MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=443
MIKROTIK_USER=wifi-control
MIKROTIK_PASSWORD=change-me
MIKROTIK_TLS_INSECURE=true

SYNC_INTERVAL_MS=12000
HEARTBEAT_INTERVAL_MS=30000
COMMAND_POLL_INTERVAL_MS=5000
