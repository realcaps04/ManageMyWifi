# Point this agent at your ManageMyWifi API (local or public):
BACKEND_URL=http://localhost:4000/api/v1
# After deploy:
# BACKEND_URL=https://your-app.vercel.app/api/v1

AGENT_SHARED_SECRET=dev-agent-shared-secret
AGENT_NAME=local-agent
NETWORK_ID=00000000-0000-4000-8000-000000000001

# Router host/user/password are entered in the website:
#   Settings → Connect your router
# Optional local fallback only (leave blank for normal users):
# ROUTER_HOST=192.168.1.1
# ROUTER_PORT=443
# ROUTER_USER=admin
# ROUTER_PASSWORD=
# ROUTER_TLS_INSECURE=true

SYNC_INTERVAL_MS=12000
HEARTBEAT_INTERVAL_MS=30000
COMMAND_POLL_INTERVAL_MS=5000
