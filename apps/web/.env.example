# Public API base URL (required on Vercel — must be HTTPS in production)
# Example: https://api.yourdomain.com/api/v1
# Leave empty for local Vite proxy to http://localhost:4000
VITE_API_URL=https://YOUR_API_HOST/api/v1

# Optional — Supabase Auth (frontend anon key only)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
