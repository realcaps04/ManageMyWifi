{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".vercel-api-build",
    "rootDir": "."
  },
  "include": ["api/**/*.ts", "apps/api/src/**/*.ts"]
}
