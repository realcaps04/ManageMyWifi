# =============================================================================
# ManageMyWifi — Environment Variables
# Copy to apps/web/.env, apps/api/.env, and apps/agent/.env as needed.
# Never commit real secrets.
# =============================================================================

# --- Web (Vite) ---
# Leave empty for local Vite proxy to http://localhost:4000
VITE_API_URL=

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
# Comma-separated origins
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=change-me-session-secret
# Web sign-in verification (WiFi name + password)
WIFI_LOGIN_SSID=YourWifiName
WIFI_LOGIN_PASSWORD=change-me-wifi-portal-password
# Set true only to skip sign-in during local debugging
DEV_AUTH_BYPASS=true
# Agent shared secret used for agent registration / auth
AGENT_SHARED_SECRET=change-me-agent-shared-secret
DEV_NETWORK_ID=00000000-0000-4000-8000-000000000001

# --- Agent ---
BACKEND_URL=http://localhost:4000/api/v1
AGENT_ID=
AGENT_TOKEN=
NETWORK_ID=
# Your WiFi router REST API (local network only — never expose publicly)
ROUTER_HOST=192.168.88.1
ROUTER_PORT=443
ROUTER_USER=wifi-control
ROUTER_PASSWORD=
ROUTER_TLS_INSECURE=true
# Polling intervals (ms)
SYNC_INTERVAL_MS=12000
HEARTBEAT_INTERVAL_MS=30000
COMMAND_POLL_INTERVAL_MS=5000
