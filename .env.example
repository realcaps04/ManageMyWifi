# =============================================================================
# WiFi Control — Environment Variables
# Copy to apps/web/.env, apps/api/.env, and apps/agent/.env as needed.
# Never commit real secrets.
# =============================================================================

# --- Supabase (API + Web) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Web (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:4000/api/v1

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
# Comma-separated origins
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
# Agent shared secret used for agent registration / auth
AGENT_SHARED_SECRET=change-me-agent-shared-secret
# Encrypts router credentials at rest (32-byte hex recommended)
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Agent ---
BACKEND_URL=http://localhost:4000/api/v1
AGENT_ID=
AGENT_TOKEN=
NETWORK_ID=
# MikroTik RouterOS REST API (local network only — never expose publicly)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=443
MIKROTIK_USER=wifi-control
MIKROTIK_PASSWORD=
MIKROTIK_TLS_INSECURE=true
# Polling intervals (ms)
SYNC_INTERVAL_MS=12000
HEARTBEAT_INTERVAL_MS=30000
COMMAND_POLL_INTERVAL_MS=5000
